{
  "name": "ecolife-environment-hub",
  "version": "1.0.0",
  "description": "Environment & Animal Safety Hub with Database Integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node backend/init-db.js",
    "lint": "htmlhint \"frontend/**/*.html\" && stylelint \"frontend/css/**/*.css\"",
    "format": "prettier --write \"frontend/**/*.{html,css,js}\"",
    "test": "playwright test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.2.0",
    "joi": "^17.9.2",
    "mongoose": "^7.5.0",
    "multer": "^2.0.2",
    "paypal-rest-sdk": "^1.8.1",
    "stripe": "^20.3.0",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "htmlhint": "^1.8.0",
    "http-server": "^14.1.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "stylelint": "^17.1.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "keywords": [
    "environment",
    "animal-safety",
    "sustainability",
    "education"
  ],
  "author": "EcoLife Team",
  "license": "MIT"
}
